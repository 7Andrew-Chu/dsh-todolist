{
  "name": "dsh-todolist",
  "version": "1.1.6",
  "private": true,
  "description": "A floating glass to-do card for the Harness Web UI with drag placement, hide/show and inline category creation.",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "todo", "todolist", "widget"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
